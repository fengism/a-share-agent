# LLM 配置
LLM_PROVIDER=zhipu
LLM_API_MODE=auto
LLM_API_VERSION=
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=GLM-4.7-Flash
LLM_TEMPERATURE=0.1
# 单次网络读写等待上限；总生成时限另行控制
# Agent 调研总预算为 1200 秒时，单次模型读取仍可能在此处配置的 300 秒提前超时。
LLM_TIMEOUT_SECONDS=300
# 普通结构化生成/资讯解读总时限，包含排队、退避和 JSON 修复
LLM_GENERATION_TIMEOUT_SECONDS=1200
LLM_GENERATION_MAX_COMPLETION_TOKENS=8192
# 含首次请求，最多 3 次；SDK 重试关闭，由共用调用层控制
LLM_MAX_ATTEMPTS=2
# 可选：按实际模型/网关限制设置输出上限（含推理 token），未设置时不猜测
# LLM_MODEL_MAX_COMPLETION_TOKENS=4096
# 不支持这些可选参数的网关可显式关闭；不会自动重放请求来探测协议
LLM_STREAM_INCLUDE_USAGE=true
LLM_JSON_MODE_ENABLED=true
# 精确匹配 provider + base_url；可追加 model/api_mode/api_version，详见 README
# 部署级 JSON 数组；不在设置页开放，修改后重启后端；不要填写密钥
LLM_COMPATIBILITY_OVERRIDES=[]
# 个股/产业链报告总生成时限（含 JSON 修复）与输出预算
ANALYSIS_LLM_TIMEOUT_SECONDS=1200
ANALYSIS_LLM_MAX_COMPLETION_TOKENS=32768
# 前置 Agent 调研独立总时限，覆盖所有轮次、追问和工具等待
AGENT_RESEARCH_TIMEOUT_SECONDS=1200
# 产业链独立实际工具调用预算；不修改聊天额度。提高预算可能增加耗时/模型费用。
# 主调研8~128，补证4~48；默认总上限72+24，实际受证据完成、轮次及超时约束。
INDUSTRY_CHAIN_TOOL_CALLS_TOTAL=72
INDUSTRY_CHAIN_REPAIR_TOOL_CALLS_TOTAL=24

# 数据缓存有效期（秒）
APP_DATA_DIR=data
CACHE_TTL_ANALYSIS=14400
# 分析聚合接口中每个数据分区的独立超时时间，单个分区超时不影响其他分区返回。
ANALYSIS_PAGE_SECTION_TIMEOUT_SECONDS=15
# 市场统计中板块、涨跌分布和涨跌停池各自的独立超时时间。
MARKET_STATISTICS_SECTION_TIMEOUT_SECONDS=15
PORTFOLIO_QUOTE_CACHE_TTL_SECONDS=10
PORTFOLIO_QUOTE_STALE_TTL_SECONDS=300
TWITTER_POST_RETENTION_DAYS=90

# 量化策略 YAML 目录与热加载轮询间隔。容器部署可将外部目录挂载后覆盖路径。
QUANT_STRATEGY_DIR=app/modules/quant/strategies/definitions
QUANT_STRATEGY_RELOAD_SECONDS=5
# Docker Compose 将此宿主机目录只读挂载到后端容器；可改为独立策略发布目录。
QUANT_STRATEGY_HOST_DIR=./backend/app/modules/quant/strategies/definitions

# Chat 调用保护：单用户并发、实例总并发、整次请求超时与 SSE 心跳间隔
MAX_CONCURRENT_CHAT_PER_USER=2
MAX_CONCURRENT_CHAT_TOTAL=8
MAX_CONCURRENT_LLM_REQUESTS=6
BLOCKING_THREAD_POOL_WORKERS=20
CHAT_MAX_COMPLETION_TOKENS=4096
CHAT_TOTAL_TIMEOUT_SECONDS=300
CHAT_HEARTBEAT_SECONDS=15
CHAT_TOOL_TIMEOUT_SECONDS=45
CHAT_MAX_TOOL_CALLS_PER_ROUND=8
CHAT_MAX_TOOL_CALLS_TOTAL=32
CHAT_MAX_TOOL_CONTEXT_CHARACTERS=60000
CHAT_MAX_SYNTHESIS_CHARACTERS=60000
MULTI_AGENT_ENABLED=true

# Provider Gateway 重试与熔断
PROVIDER_GATEWAY_MAX_ATTEMPTS=2
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_OPEN_SECONDS=30.0
PROVIDER_RETRY_BASE_SECONDS=0.2
PROVIDER_RETRY_BUDGET_SECONDS=5.0
PROVIDER_RETRY_JITTER_SECONDS=0.1

# TDX 行情数据源：后端通过 tdxhub-sdk 进程内直连通达信服务器（始终启用，无独立 sidecar 容器）。
TDXHUB_TIMEOUT_SECONDS=10
# 个股资金流备选源总 I/O 预算；独立连接，最多 90 秒
TDXHUB_FUND_FLOW_TIMEOUT_SECONDS=60

# Docker Compose 映射到宿主机的前端端口与绑定地址（默认仅本机可访问；公网部署改为 0.0.0.0 需自行确保有鉴权/防火墙）
DOCKER_FRONTEND_PORT=8080
DOCKER_FRONTEND_BIND_ADDRESS=127.0.0.1
# Docker 部署可选镜像与 Docker socket（可自定义镜像仓库或非标准 socket 路径）
# BACKEND_IMAGE=fengliu1989/a-share-backend:main
# FRONTEND_IMAGE=fengliu1989/a-share-frontend:main
# DOCKER_SOCKET=/var/run/docker.sock

# Notion 转存配置
NOTION_ENABLED=false
NOTION_API_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_DATABASE_ID=

# 飞书推送配置
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_FOLDER_TOKEN=
FEISHU_WIKI_SPACE_ID=
FEISHU_WIKI_DAILY_REVIEW_PARENT=
FEISHU_WIKI_ANALYSIS_PARENT=
FEISHU_DAILY_REVIEW_FOLDER=
FEISHU_ANALYSIS_FOLDER=
FEISHU_DEFAULT_RECEIVER=

# 飞书 Bot Command（事件订阅回调：POST /api/bot/feishu）
BOT_ENABLED=false
BOT_COMMAND_PREFIX=/
# Bot 复用该本地账号的模型配置、持仓和分析存储；填数据库 users.id。
BOT_SERVICE_USER_ID=0
BOT_FEISHU_APP_ID=
BOT_FEISHU_APP_SECRET=
BOT_RATE_LIMIT_REQUESTS=10
BOT_RATE_LIMIT_WINDOW=60
BOT_WEBHOOK_MAX_SKEW_SECONDS=300
BOT_EVENT_DEDUP_TTL_SECONDS=600
BOT_JOB_POLL_SECONDS=1.0
BOT_JOB_LEASE_SECONDS=900
BOT_JOB_MAX_ATTEMPTS=3
BOT_JOB_RETRY_BASE_SECONDS=5.0
BOT_JOB_WORKER_CONCURRENCY=2
BOT_BATCH_CONCURRENCY=2
BOT_BATCH_MAX_STOCKS=10
# 飞书用户 ID 白名单，使用 JSON 数组；/batch 仅管理员可执行。
BOT_ADMIN_USERS=[]
FEISHU_VERIFICATION_TOKEN=
# 飞书事件订阅启用加密时填写，同时用于请求签名校验。
FEISHU_ENCRYPT_KEY=

# 问财数据源配置
IWENCAI_ENABLED=false
IWENCAI_BASE_URL=https://openapi.iwencai.com
IWENCAI_API_KEY=

# Twitter/X 资讯账号列表，使用 JSON 数组格式
TWITTER_FEEDS=["qinbafrank"]

# 实例级默认关闭的 Chat Skill / 专业 Agent（JSON 数组，可选）。
# 用户仍可在设置页按账号自行开启；新能力默认启用，通常无需配置。
# DISABLED_CHAT_SKILLS=["quant_strategy_authoring"]
# DISABLED_CHAT_AGENTS=[]

# 数据源 Cookie 配置（留空使用空值，需从浏览器获取最新 Cookie 填入）
# 通过环境变量或 .env 文件配置，不再硬编码在代码中
EASTMONEY_COOKIE=
BAIDU_COOKIE=
BAIDU_ACS_TOKEN=
THS_COOKIE=
LEGULEGU_TOKEN=

# 东方财富接口共用 IP 级风控，必须串行访问。数据中心接口可使用独立间隔，
# 其余接口使用全局间隔；请求会增加 0.1~0.5 秒随机抖动。
# 遇到 403/429 或连续连接失败后进入冷却期。
EASTMONEY_MIN_INTERVAL_SECONDS=1.0
EASTMONEY_DATACENTER_MIN_INTERVAL_SECONDS=1.0
EASTMONEY_DATACENTER_COOLDOWN_SECONDS=10
EASTMONEY_JITTER_MIN_SECONDS=0.1
EASTMONEY_JITTER_MAX_SECONDS=0.5
EASTMONEY_COOLDOWN_SECONDS=300
EASTMONEY_TRANSIENT_FAILURE_THRESHOLD=3

# HTTP 客户端配置
# FRED 美国宏观数据 API Key（也可由管理员在设置页全局配置）
FRED_API_KEY=

# 设为 false 时，requests 调用将忽略系统 HTTP_PROXY/HTTPS_PROXY 环境变量
# 适用于代理不可用或需要直连的部署环境
HTTP_TRUST_ENV=true

# Web Fetch 解压后的单个响应体上限（字节），范围 64 KiB ~ 100 MiB。
WEB_FETCH_MAX_RESPONSE_BYTES=20971520
# 主进程浏览器直连抓取：stealth/dynamic。
WEB_FETCH_BROWSER_ENABLED=true
WEB_FETCH_BROWSER_TIMEOUT_SECONDS=20
WEB_FETCH_BROWSER_SETTLE_SECONDS=10
WEB_FETCH_BROWSER_MAX_CONCURRENCY=2

# 账号系统 / 登录安全
# 说明：以上 LLM / 飞书 / Notion / 问财 为“实例级默认值”；启用账号系统后，
# 每个登录用户可在「设置」里覆盖自己的私密项（互不可见）。数据源 Cookie、
# Twitter 账号、HTTP_TRUST_ENV 等为全局项，仅管理员可改。
#
# 登录失败限流（防暴力破解，按“用户名 + 客户端 IP”双维度计数）。
# 从 .env 加载（pydantic Settings，本地开发与 Docker 一致）；均为可选，未设置时用以下默认值。
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCK_SECONDS=300
# 是否信任 X-Forwarded-For 解析客户端真实 IP。直连后端时保持 false；
# docker-compose.yml 中的后端仅经内置 Nginx 访问，因此会固定覆盖为 true。
TRUST_PROXY_HEADERS=false
# HTTPS 环境设为 true，使登录 Cookie 仅通过安全连接发送。
AUTH_COOKIE_SECURE=false
# 会话有效期与滑动续期为代码内置常量（backend/app/core/security.py 的
# SESSION_TTL_DAYS=14、SESSION_RENEW_THRESHOLD_DAYS=7），非环境变量，如需调整改代码。

# 首次启动（空库）自动创建的默认管理员用户名；密码随机生成并打印到后端日志，首登强制改密。
DEFAULT_ADMIN_USERNAME=admin

# 用户在「设置」中保存的 API Key / Token 使用 AES-GCM 加密后写入数据库。
# 必须是 URL-safe Base64 编码的 32 字节随机值，生成示例：
# cd backend && uv run python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
CONFIG_ENCRYPTION_KEY=
# 轮换时将旧密钥按逗号分隔保留在此；旧密文成功读取后会自动用当前密钥重加密。
CONFIG_ENCRYPTION_PREVIOUS_KEYS=

# 可选：供 Prometheus/监控系统读取 /api/health/metrics，使用 X-Metrics-Key 请求头。
# 未配置时仍可使用管理员 Bearer Token 访问。
METRICS_API_KEY=

# 多实例后台周期任务使用数据库租约选主；通常保持默认值即可。
BACKGROUND_TASK_JITTER_SECONDS=15
BACKGROUND_TASK_LEASE_SECONDS=60
BACKGROUND_TASK_STANDBY_POLL_SECONDS=10
BACKGROUND_TASK_READINESS_FAILURE_THRESHOLD=3

# Analysis / Industry Chain 持久化任务队列。
WORKFLOW_JOB_WORKER_CONCURRENCY=2
WORKFLOW_JOB_MAX_RUNNING_PER_USER=1
WORKFLOW_JOB_MAX_ACTIVE_PER_USER=10
WORKFLOW_JOB_MAX_ACTIVE_TOTAL=100
WORKFLOW_JOB_RETENTION_SECONDS=2592000
# 任务轮询间隔、租约时长、失败重试次数与重试退避基数。
WORKFLOW_JOB_POLL_SECONDS=0.5
WORKFLOW_JOB_LEASE_SECONDS=900
WORKFLOW_JOB_MAX_ATTEMPTS=2
WORKFLOW_JOB_RETRY_BASE_SECONDS=5.0

# SQLite 使用在线备份 API 定期写入 APP_DATA_DIR/backups，并在写入后执行 quick_check。
DATABASE_BACKUP_ENABLED=true
DATABASE_BACKUP_INTERVAL_SECONDS=86400
DATABASE_BACKUP_RETENTION_COUNT=7
# 可选：将主备份目录挂载到独立磁盘，并将校验后的副本同步到远端挂载目录。
# DATABASE_BACKUP_DIR=/mnt/stock-agent-backups
# DATABASE_BACKUP_MIRROR_DIR=/mnt/remote-stock-agent-backups

# CORS 允许来源（逗号分隔）。前后端同源部署（默认经 Nginx）无需修改；
# 若前端部署在独立域名，填入其来源，例如 https://stock.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 国家统计局 UUID 数据接口热修复（通常留空；仅在官方 endpoint 改名时填写完整 POST URL）
NBSC_DATA_URL=

# 可选隔离 Python：不配置时明确不可用，固定财务公式仍可用；无本机执行回退。
# 先构建：docker compose --profile python-sandbox --profile python-sandbox-build build python-runner python-sandbox-image
# 设置 URL=http://python-runner:8080 及至少32位随机共享密钥，再启动：
# docker compose --profile python-sandbox up -d
PYTHON_SANDBOX_URL=
PYTHON_SANDBOX_TOKEN=
# 仅控制服务挂载；后端和每次执行的容器均不得挂载 Docker socket。
# 可指向独立执行主机/独立 daemon 的本地 Unix socket，进一步隔离业务宿主机。
# PYTHON_SANDBOX_DOCKER_SOCKET=/var/run/docker.sock

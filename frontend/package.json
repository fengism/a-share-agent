{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api:check": "node scripts/check-api-generated.mjs",
    "api:export": "cd ../backend && uv run --frozen python -m app.scripts.export_openapi ../frontend/src/api/generated/openapi.json",
    "api:generate": "npm run api:export && npm run api:generate:types && npm run api:generate:financial-labels",
    "api:generate:types": "openapi-typescript src/api/generated/openapi.json -o src/api/generated/schema.ts && openapi-typescript src/api/generated/openapi.json -o src/api/generated/request-schema.ts --default-non-nullable false",
    "api:generate:financial-labels": "node scripts/generate-financial-field-labels.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . && node scripts/check-page-boundaries.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@tanstack/react-query": "^5.100.3",
    "antd": "^6.3.6",
    "dayjs": "^1.11.11",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lightweight-charts": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@eslint/js": "^9.13.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
